<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*" Name="Obylon Sentinel" Language="1033" Version="6.3.5.0" Manufacturer="Obylon Systems" UpgradeCode="12345678-1234-1234-1234-123456789012">
        <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />
        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <!-- Properties -->
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
        <Property Id="DEPLOY_MODE" Value="SINGLE" />
        <Property Id="LICENSEKEY" Hidden="yes" />

        <!-- Directory Structure -->
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFilesFolder">
                <Directory Id="INSTALLFOLDER" Name="Obylon" />
            </Directory>
            <Directory Id="CommonAppDataFolder">
                <Directory Id="ObylonDataFolder" Name="Obylon" />
            </Directory>
        </Directory>

        <!-- Components -->
        <DirectoryRef Id="INSTALLFOLDER">
            <Component Id="AgentExecutable" Guid="*">
                <File Id="SentinelExe" Source="obylon.exe" KeyPath="yes" />
                
                <!-- PATH Registration -->
                <Environment Id="AddInstallDirToPath" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="ObylonDataFolder">
            <Component Id="ProgramDataFolder" Guid="*">
                <CreateFolder>
                    <Permission User="SYSTEM" GenericAll="yes" />
                    <Permission User="Administrators" GenericAll="yes" />
                </CreateFolder>
            </Component>
        </DirectoryRef>

        <!-- Features -->
        <Feature Id="ProductFeature" Title="Obylon Sentinel" Level="1">
            <ComponentRef Id="AgentExecutable" />
            <ComponentRef Id="ProgramDataFolder" />
        </Feature>

        <!-- Custom Actions for Deployment Modes -->
        <CustomAction Id="Set_Single_Activation" Property="Single_Activation" Value="[LICENSEKEY]" />
        <CustomAction Id="Single_Activation"
                      Directory="INSTALLFOLDER"
                      ExeCommand="&quot;[INSTALLFOLDER]obylon.exe&quot; activate [CustomActionData]"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore" />
                      
        <CustomAction Id="Set_Fleet_Seed_Drop" Property="Fleet_Seed_Drop" Value="[LICENSEKEY]" />
        <CustomAction Id="Fleet_Seed_Drop"
                      Directory="INSTALLFOLDER"
                      ExeCommand="cmd.exe /c &quot;echo [CustomActionData] &gt; C:\ProgramData\Obylon\license_seed.txt&quot;"
                      Execute="deferred"
                      Impersonate="no"
                      Return="check" />
                      
        <!-- Custom Action for Scheduled Task -->
        <CustomAction Id="RegisterStartupTask"
                      Directory="INSTALLFOLDER"
                      ExeCommand="schtasks /Create /TN &quot;ObylonAgent&quot; /TR &quot;[INSTALLFOLDER]obylon.exe&quot; /SC ONSTART /RL HIGHEST /F"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore" />
                      
        <CustomAction Id="RemoveStartupTask"
                      Directory="INSTALLFOLDER"
                      ExeCommand="schtasks /Delete /TN &quot;ObylonAgent&quot; /F"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore" />

        <!-- Custom Action Sequencing -->
        <InstallExecuteSequence>
            <Custom Action="Set_Single_Activation" After="InstallFiles">
                <![CDATA[DEPLOY_MODE="SINGLE" AND NOT Installed]]>
            </Custom>
            <Custom Action="Single_Activation" After="Set_Single_Activation">
                <![CDATA[DEPLOY_MODE="SINGLE" AND NOT Installed]]>
            </Custom>
            
            <Custom Action="Set_Fleet_Seed_Drop" After="InstallFiles">
                <![CDATA[DEPLOY_MODE="FLEET" AND NOT Installed]]>
            </Custom>
            <Custom Action="Fleet_Seed_Drop" After="Set_Fleet_Seed_Drop">
                <![CDATA[DEPLOY_MODE="FLEET" AND NOT Installed]]>
            </Custom>
            
            <Custom Action="RegisterStartupTask" After="InstallFiles">
                <![CDATA[NOT Installed]]>
            </Custom>
            
            <Custom Action="RemoveStartupTask" Before="RemoveFiles">
                <![CDATA[REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE]]>
            </Custom>
        </InstallExecuteSequence>

        <!-- Custom UI for Licensing -->
        <UI Id="WixUI_Obylon">
            <UIRef Id="WixUI_InstallDir" />

            <Dialog Id="LicenseActivationDlg" Width="370" Height="270" Title="Obylon Sentinel Activation">
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next">
                    <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
                </Control>
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back">
                    <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>

                <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes">
                    <Text>{\WixUI_Font_Title}Deployment Configuration</Text>
                </Control>
                <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes">
                    <Text>Choose how this endpoint should be provisioned.</Text>
                </Control>

                <!-- Radio Buttons for Deployment Mode -->
                <Control Id="ModeLabel" Type="Text" X="20" Y="60" Width="290" Height="15" Text="Select Deployment Mode:" />
                <Control Id="DeployModeRadio" Type="RadioButtonGroup" X="20" Y="80" Width="330" Height="40" Property="DEPLOY_MODE">
                    <RadioButtonGroup Property="DEPLOY_MODE">
                        <RadioButton Value="SINGLE" X="0" Y="0" Width="330" Height="15" Text="Single Workstation (Activate Immediately)" />
                        <RadioButton Value="FLEET" X="0" Y="20" Width="330" Height="15" Text="Master Image (Seed for Fleet Deployment)" />
                    </RadioButtonGroup>
                </Control>

                <!-- License Key Input -->
                <Control Id="KeyLabel" Type="Text" X="20" Y="140" Width="290" Height="15" Text="Enterprise License Key:" />
                <Control Id="LicenseKeyEdit" Type="Edit" X="20" Y="160" Width="250" Height="15" Property="LICENSEKEY" Password="yes" />
            </Dialog>

            <!-- Inject our custom dialog into the WixUI_InstallDir flow -->
            <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="LicenseActivationDlg" Order="4">1</Publish>
            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="LicenseActivationDlg" Order="1">NOT Installed</Publish>
        </UI>
    </Product>
</Wix>
